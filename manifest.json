{
  "manifest_version": 3,
  "name": "115 媒体整理",
  "version": "0.0.57",
  "minimum_chrome_version": "114",
  "description": "在 115 网盘中扫描、解析、TMDB 片名校准并批量整理媒体文件",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "115 媒体整理",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "options_page": "options/index.html",
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://115.com/*",
        "https://*.115.com/*"
      ],
      "js": ["content/injector.js"],
      "css": ["content/injector.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://115.com/*",
    "https://*.115.com/*",
    "https://webapi.115.com/*",
    "https://api.themoviedb.org/*",
    "https://www.themoviedb.org/*",
    "https://movie.douban.com/*",
    "https://raw.githubusercontent.com/*"
  ]
}
